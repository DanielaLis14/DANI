<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane fx:id="rootPane" maxHeight="500.0" maxWidth="700.0" minHeight="500.0" minWidth="700.0" prefHeight="500.0" prefWidth="700.0" styleClass="root-container" stylesheets="@../../css/modern-login.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.farmafx.controller.LoginController">

    <!-- Container Principal -->
    <VBox styleClass="main-container">

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" styleClass="header">
            <padding>
                <Insets left="20.0" right="10.0" />
            </padding>

            <Label styleClass="header-title" text="FarmaFx">
                <font>
                    <Font name="System" size="14.0" />
                </font>
            </Label>

            <Region HBox.hgrow="ALWAYS" />

            <Button fx:id="btnClose" onAction="#cerrar" styleClass="btn-close" text="✕">
                <font>
                    <Font size="18.0" />
                </font>
            </Button>
        </HBox>

        <!-- Login Card -->
        <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="700.0" minWidth="-Infinity" prefHeight="450.0" prefWidth="700.0" styleClass="login-card" VBox.vgrow="ALWAYS">
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>

            <!-- Logo -->
            <ImageView fitHeight="310.0" fitWidth="143.0" preserveRatio="true">
                <image>
                    <Image url="@../../img/FarmaFx.png" />
                </image>
            </ImageView>

            <!-- Campo Usuario -->
            <TextField fx:id="txtUsername" maxWidth="450.0" prefHeight="45.0" promptText="Usuario" styleClass="input-field">
                <font>
                    <Font size="14.0" />
                </font>
                <VBox.margin>
                    <Insets top="25.0" />
                </VBox.margin>
            </TextField>

            <!-- Campo Contraseña -->
            <PasswordField fx:id="txtPassword" maxWidth="450.0" onAction="#login" prefHeight="45.0" promptText="Contraseña" styleClass="input-field">
                <font>
                    <Font size="14.0" />
                </font>
                <VBox.margin>
                    <Insets top="12.0" />
                </VBox.margin>
            </PasswordField>

            <!-- Checkbox Recordar -->
            <CheckBox fx:id="chkRememberMe" styleClass="checkbox-remember" text="Recordar usuario">
                <font>
                    <Font size="13.0" />
                </font>
                <VBox.margin>
                    <Insets top="12.0" />
                </VBox.margin>
            </CheckBox>

            <!-- Botón Login -->
            <Button fx:id="btnLogin" defaultButton="true" maxWidth="450.0" onAction="#login" prefHeight="48.0" styleClass="btn-login" text="Login">
                <font>
                    <Font name="System" size="15.0" />
                </font>
                <VBox.margin>
                    <Insets top="18.0" />
                </VBox.margin>
            </Button>

        </VBox>

    </VBox>

    <!-- Overlay de Progreso (Fondo oscuro + Spinner central) -->
    <StackPane fx:id="progressOverlay" visible="false" style="-fx-background-color: rgba(5, 8, 16, 0.85);" StackPane.alignment="CENTER">
        <VBox alignment="CENTER" spacing="20">
            <ProgressIndicator fx:id="piProgreso" prefHeight="80.0" prefWidth="80.0" style="-fx-progress-color: #1f85ce;" />
            <Label text="Autenticando..." style="-fx-text-fill: #E2E8F0; -fx-font-size: 16px;" />
        </VBox>
    </StackPane>

</StackPane>
