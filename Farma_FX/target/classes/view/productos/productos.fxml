<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="720.0" prefWidth="1200.0" styleClass="productos-root" stylesheets="@../../css/components.css, @../../css/filters.css, @../../css/search.css, @../../css/buttons.css, @../../css/forms.css, @../../css/tables.css, @../../css/pagination.css, @../../css/cruds.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.farmafx.controller.ProductosGoldController">

    <!-- ============================================
         TOP: Barra de búsqueda y botones de acción
         ============================================ -->
    <top>
        <VBox spacing="0" styleClass="top-section">
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="search-bar">
                <!-- Búsqueda con icono integrado -->
                <HBox fx:id="searchContainer" alignment="CENTER_LEFT" maxWidth="500" spacing="0" styleClass="search-container" HBox.hgrow="ALWAYS">
                    <StackPane styleClass="search-icon-wrapper">
                        <FontAwesomeIconView glyphName="SEARCH" glyphSize="14" styleClass="search-icon" />
                    </StackPane>

                    <TextField fx:id="txtBusqueda" promptText="Buscar por código, nombre o marca..." styleClass="search-input" HBox.hgrow="ALWAYS" />

                    <Button fx:id="btnLimpiarBusqueda" managed="false" styleClass="search-clear-btn" visible="false">
                        <graphic>
                            <FontAwesomeIconView glyphName="TIMES" glyphSize="12" styleClass="clear-icon" />
                        </graphic>
                        <tooltip>
                            <Tooltip text="Limpiar búsqueda (Esc)" />
                        </tooltip>
                    </Button>
                </HBox>

                <!-- Filtro de Estado -->
                <Label styleClass="filter-label" text="Estado:" />
                <ComboBox fx:id="cmbEstadoFiltro" prefWidth="120" promptText="Filtrar" styleClass="filter-combo">
                    <tooltip>
                        <Tooltip text="Filtrar por estado" />
                    </tooltip>
                </ComboBox>

                <!-- Filtro de Ordenamiento -->
                <Label styleClass="filter-label" text="Ordenar:" />
                <ComboBox fx:id="cmbOrdenamiento" prefWidth="140" promptText="Ordenar" styleClass="filter-combo">
                    <tooltip>
                        <Tooltip text="Ordenar tabla" />
                    </tooltip>
                </ComboBox>

                <!-- Botón Reiniciar (minimalista) -->
                <Button fx:id="btnLimpiar" styleClass="btn-icon-secondary">
                    <graphic>
                        <FontAwesomeIconView glyphName="REFRESH" glyphSize="14" styleClass="icon-secondary" />
                    </graphic>
                    <tooltip>
                        <Tooltip text="Reiniciar vista" />
                    </tooltip>
                </Button>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Botones de acción principales -->
                <Button fx:id="btnNuevo" managed="false" styleClass="btn-success" text="Nuevo" visible="false">
                    <graphic>
                        <FontAwesomeIconView fill="WHITE" glyphName="PLUS" glyphSize="12" />
                    </graphic>
                </Button>

                <Button fx:id="btnEditar" disable="true" managed="false" styleClass="btn-primary" text="Editar" visible="false">
                    <graphic>
                        <FontAwesomeIconView fill="WHITE" glyphName="EDIT" glyphSize="12" />
                    </graphic>
                </Button>

                <Button fx:id="btnInactivar" disable="true" managed="false" styleClass="btn-warning" text="Activar/Inactivar" visible="false">
                    <graphic>
                        <FontAwesomeIconView fill="WHITE" glyphName="CIRCLE" glyphSize="10" />
                    </graphic>
                </Button>

                <Button fx:id="btnEliminar" disable="true" managed="false" styleClass="btn-danger" text="Eliminar" visible="false">
                    <graphic>
                        <FontAwesomeIconView fill="WHITE" glyphName="TRASH" glyphSize="12" />
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </top>

    <!-- ============================================
         CENTER: Formulario + Tabla (con scroll)
         ============================================ -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll" vbarPolicy="AS_NEEDED">
            <VBox spacing="12" styleClass="content-area">
            <!-- Formulario compacto -->
            <VBox spacing="8" styleClass="form-card">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label styleClass="form-title" text="Formulario de Producto" />
                    <ProgressIndicator fx:id="piProgreso" prefHeight="20.0" prefWidth="20.0" styleClass="progress-small" visible="false" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblMensajeForm" styleClass="form-error-label" />
                </HBox>

                <!-- Grid del formulario -->
                <GridPane hgap="14" styleClass="form-grid" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" minWidth="80" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="150" />
                        <ColumnConstraints halignment="RIGHT" minWidth="80" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="200" />
                        <ColumnConstraints halignment="RIGHT" minWidth="80" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="250" />
                    </columnConstraints>

                    <!-- Fila 1: ID, Código, Nombre -->
                    <Label styleClass="form-label" text="ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <HBox alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label fx:id="lblId" styleClass="id-badge" text="—" />
                    </HBox>

                    <Label styleClass="form-label" text="Código:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                    <HBox alignment="CENTER_LEFT" spacing="8" GridPane.columnIndex="3" GridPane.rowIndex="0">
                        <Label fx:id="lblCodigo" styleClass="id-badge codigo-badge" text="—" />
                    </HBox>

                    <Label styleClass="form-label" text="Nombre:*" GridPane.columnIndex="4" GridPane.rowIndex="0" GridPane.valignment="TOP" />
                    <VBox spacing="2" GridPane.columnIndex="5" GridPane.rowIndex="0">
                        <TextField fx:id="txtNombre" promptText="Nombre del producto" styleClass="form-input" />
                        <HBox alignment="CENTER_RIGHT">
                            <Label fx:id="lblContadorNombre" styleClass="counter-normal" text="0/120" />
                        </HBox>
                    </VBox>

                    <!-- Fila 2: Marca, Categoría, Unidad Medida -->
                    <Label styleClass="form-label" text="Marca:*" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <ComboBox fx:id="cbxMarca" prefWidth="150" promptText="Seleccione" styleClass="form-input" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <tooltip>
                            <Tooltip text="Marca del producto (obligatorio)" />
                        </tooltip>
                    </ComboBox>

                    <Label styleClass="form-label" text="Categoría:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                    <ComboBox fx:id="cbxCategoria" prefWidth="200" promptText="Seleccione" styleClass="form-input" GridPane.columnIndex="3" GridPane.rowIndex="1">
                        <tooltip>
                            <Tooltip text="Categoría del producto (opcional)" />
                        </tooltip>
                    </ComboBox>

                    <Label styleClass="form-label" text="Unidad:*" GridPane.columnIndex="4" GridPane.rowIndex="1" />
                    <ComboBox fx:id="cbxUnidadMedida" prefWidth="150" promptText="Seleccione" styleClass="form-input" GridPane.columnIndex="5" GridPane.rowIndex="1">
                        <tooltip>
                            <Tooltip text="Unidad de medida (obligatorio)" />
                        </tooltip>
                    </ComboBox>

                    <!-- Fila 3: Precio Compra, Precio Venta, Stocks -->
                    <Label styleClass="form-label" text="P. Compra:*" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <TextField fx:id="txtPrecioCompra" promptText="0.00" styleClass="form-input" GridPane.columnIndex="1" GridPane.rowIndex="2">
                        <tooltip>
                            <Tooltip text="Precio de compra (S/)" />
                        </tooltip>
                    </TextField>

                    <Label styleClass="form-label" text="P. Venta:*" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                    <TextField fx:id="txtPrecioVenta" promptText="0.00" styleClass="form-input" GridPane.columnIndex="3" GridPane.rowIndex="2">
                        <tooltip>
                            <Tooltip text="Precio de venta (S/)" />
                        </tooltip>
                    </TextField>

                    <Label styleClass="form-label" text="Stock:*" GridPane.columnIndex="4" GridPane.rowIndex="2" />
                    <HBox spacing="8" GridPane.columnIndex="5" GridPane.rowIndex="2">
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label styleClass="form-sublabel" text="Actual" />
                            <TextField fx:id="txtStockActual" promptText="0" styleClass="form-input">
                                <tooltip>
                                    <Tooltip text="Stock actual disponible" />
                                </tooltip>
                            </TextField>
                        </VBox>
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label styleClass="form-sublabel" text="Mínimo" />
                            <TextField fx:id="txtStockMinimo" promptText="0" styleClass="form-input">
                                <tooltip>
                                    <Tooltip text="Stock mínimo para alerta" />
                                </tooltip>
                            </TextField>
                        </VBox>
                    </HBox>

                    <!-- Fila 4: Descripción (ocupa 3 columnas) -->
                    <Label styleClass="form-label" text="Descripción:" GridPane.columnIndex="0" GridPane.rowIndex="3" GridPane.valignment="TOP" />
                    <VBox spacing="2" GridPane.columnIndex="1" GridPane.columnSpan="5" GridPane.rowIndex="3">
                        <TextArea fx:id="txtDescripcion" minHeight="50.0" prefHeight="70.0" promptText="Descripción opcional del producto" styleClass="form-input" wrapText="true" />
                        <HBox alignment="CENTER_RIGHT">
                            <Label fx:id="lblContadorDesc" styleClass="counter-normal" text="0/200" />
                        </HBox>
                    </VBox>

                    <!-- Fila 5: Estado y Botones -->
                    <CheckBox fx:id="chkEstado" styleClass="form-checkbox" text="Activo" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                    <HBox alignment="CENTER_RIGHT" spacing="10" GridPane.columnIndex="5" GridPane.rowIndex="4">
                        <Button fx:id="btnGuardar" styleClass="btn-primary-small" text="Guardar">
                            <graphic>
                                <FontAwesomeIconView fill="WHITE" glyphName="CHECK" glyphSize="11" />
                            </graphic>
                        </Button>
                        <Button fx:id="btnCancelar" styleClass="btn-secondary-small" text="Cancelar">
                            <graphic>
                                <FontAwesomeIconView glyphName="TIMES" glyphSize="11" />
                            </graphic>
                        </Button>
                    </HBox>
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>
                </GridPane>
            </VBox>

            <!-- Tabla de Productos -->
            <VBox spacing="6" styleClass="table-card" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label styleClass="table-title" text="Lista de Productos" />
                    <Label fx:id="lblTotalProductos" styleClass="table-count" text="(0 registros)" />
                </HBox>

                <TableView fx:id="tableProductos" editable="false" minHeight="350" prefHeight="400" styleClass="modern-table">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="50.0" styleClass="col-id" text="ID" />
                        <TableColumn fx:id="colCodigo" prefWidth="90.0" styleClass="col-codigo" text="Código" />
                        <TableColumn fx:id="colNombre" prefWidth="180.0" styleClass="col-nombre" text="Nombre" />
                        <TableColumn fx:id="colMarca" prefWidth="110.0" styleClass="col-marca" text="Marca" />
                        <TableColumn fx:id="colCategoria" prefWidth="120.0" styleClass="col-categoria" text="Categoría" />
                        <TableColumn fx:id="colPrecioCompra" prefWidth="90.0" styleClass="col-precio" text="P. Compra" />
                        <TableColumn fx:id="colPrecioVenta" prefWidth="90.0" styleClass="col-precio" text="P. Venta" />
                        <TableColumn fx:id="colStock" prefWidth="70.0" styleClass="col-stock" text="Stock" />
                        <TableColumn fx:id="colEstado" prefWidth="80.0" styleClass="col-estado" text="Estado" />
                    </columns>

                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>

                    <placeholder>
                        <VBox alignment="CENTER" spacing="8" style="-fx-padding: 40;">
                            <FontAwesomeIconView fill="#CBD5E1" glyphName="CUBE" glyphSize="48" />
                            <Label styleClass="table-empty-label" text="No hay productos para mostrar" />
                            <Label styleClass="table-empty-hint" text="Agrega un nuevo producto para comenzar" />
                        </VBox>
                    </placeholder>
                </TableView>

                <!-- Paginación mejorada -->
                <HBox alignment="CENTER" spacing="10" styleClass="pagination-bar">
                    <Button fx:id="btnPrimera" styleClass="btn-pagination">
                        <graphic>
                            <FontAwesomeIconView glyphName="ANGLE_DOUBLE_LEFT" glyphSize="12" />
                        </graphic>
                        <tooltip>
                            <Tooltip text="Primera página" />
                        </tooltip>
                    </Button>

                    <Button fx:id="btnAnterior" styleClass="btn-pagination">
                        <graphic>
                            <FontAwesomeIconView glyphName="CHEVRON_LEFT" glyphSize="12" />
                        </graphic>
                        <tooltip>
                            <Tooltip text="Página anterior" />
                        </tooltip>
                    </Button>

                    <Label styleClass="pagination-text" text="Página" />
                    <TextField fx:id="txtPagina" styleClass="pagination-input" text="1" />
                    <Label fx:id="lblTotalPaginas" styleClass="pagination-total" text="de 1" />

                    <Button fx:id="btnSiguiente" styleClass="btn-pagination">
                        <graphic>
                            <FontAwesomeIconView glyphName="CHEVRON_RIGHT" glyphSize="12" />
                        </graphic>
                        <tooltip>
                            <Tooltip text="Página siguiente" />
                        </tooltip>
                    </Button>

                    <Button fx:id="btnUltima" styleClass="btn-pagination">
                        <graphic>
                            <FontAwesomeIconView glyphName="ANGLE_DOUBLE_RIGHT" glyphSize="12" />
                        </graphic>
                        <tooltip>
                            <Tooltip text="Última página" />
                        </tooltip>
                    </Button>
                </HBox>
            </VBox>
            </VBox>
        </ScrollPane>
    </center>

    <padding>
        <Insets bottom="16" left="20" right="20" top="16" />
    </padding>
</BorderPane>