<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="720.0" prefWidth="1200.0" styleClass="marcas-root" stylesheets="@../../css/components.css, @../../css/filters.css, @../../css/search.css, @../../css/buttons.css, @../../css/forms.css, @../../css/tables.css, @../../css/pagination.css, @../../css/cruds.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.farmafx.controller.MarcasController">

    <!-- ============================================
         TOP: Barra de búsqueda y botones de acción
         ============================================ -->
    <top>
        <VBox spacing="0" styleClass="top-section">
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="search-bar">
                <!-- Búsqueda con icono integrado -->
                <HBox fx:id="searchContainer" alignment="CENTER_LEFT" maxWidth="500" spacing="0" styleClass="search-container" HBox.hgrow="ALWAYS">
                    <StackPane styleClass="search-icon-wrapper">
                        <FontAwesomeIconView glyphName="SEARCH" glyphSize="14" styleClass="search-icon" />
                    </StackPane>

                    <TextField fx:id="txtBusqueda" promptText="Buscar por nombre o descripción..." styleClass="search-input" HBox.hgrow="ALWAYS" />

                    <Button fx:id="btnLimpiarBusqueda" managed="false" styleClass="search-clear-btn" visible="false">
                        <graphic>
                            <FontAwesomeIconView glyphName="TIMES" glyphSize="12" styleClass="clear-icon" />
                        </graphic>
                        <tooltip>
                            <Tooltip text="Limpiar búsqueda (Esc)" />
                        </tooltip>
                    </Button>
                </HBox>

                <!-- Filtro de Estado -->
                <Label styleClass="filter-label" text="Estado:" />
                <ComboBox fx:id="cmbEstadoFiltro" prefWidth="120" promptText="Filtrar" styleClass="filter-combo">
                    <tooltip>
                        <Tooltip text="Filtrar por estado" />
                    </tooltip>
                </ComboBox>

                <!-- Filtro de Ordenamiento -->
                <Label styleClass="filter-label" text="Ordenar:" />
                <ComboBox fx:id="cmbOrdenamiento" prefWidth="140" promptText="Ordenar" styleClass="filter-combo">
                    <tooltip>
                        <Tooltip text="Ordenar tabla" />
                    </tooltip>
                </ComboBox>

                <!-- Botón Reiniciar (minimalista) -->
                <Button fx:id="btnLimpiar" styleClass="btn-icon-secondary">
                    <graphic>
                        <FontAwesomeIconView glyphName="REFRESH" glyphSize="14" styleClass="icon-secondary" />
                    </graphic>
                    <tooltip>
                        <Tooltip text="Reiniciar vista" />
                    </tooltip>
                </Button>

                <Region HBox.hgrow="ALWAYS" />

                <!-- Botones de acción principales -->
                <Button fx:id="btnNuevo" managed="false" styleClass="btn-success" text="Nuevo" visible="false">
                    <graphic>
                        <FontAwesomeIconView fill="WHITE" glyphName="PLUS" glyphSize="12" />
                    </graphic>
                </Button>

                <Button fx:id="btnEditar" disable="true" managed="false" styleClass="btn-primary" text="Editar" visible="false">
                    <graphic>
                        <FontAwesomeIconView fill="WHITE" glyphName="EDIT" glyphSize="12" />
                    </graphic>
                </Button>

                <Button fx:id="btnInactivar" disable="true" managed="false" styleClass="btn-warning" text="Activar/Inactivar" visible="false">
                    <graphic>
                        <FontAwesomeIconView fill="WHITE" glyphName="CIRCLE" glyphSize="10" />
                    </graphic>
                </Button>

                <Button fx:id="btnEliminar" disable="true" managed="false" styleClass="btn-danger" text="Eliminar" visible="false">
                    <graphic>
                        <FontAwesomeIconView fill="WHITE" glyphName="TRASH" glyphSize="12" />
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </top>

    <!-- ============================================
         CENTER: Formulario + Tabla (con scroll)
         ============================================ -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="content-scroll" vbarPolicy="AS_NEEDED">
            <VBox spacing="16" styleClass="content-area">
            <!-- Formulario compacto horizontal -->
            <VBox spacing="8" styleClass="form-card">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label styleClass="form-title" text="Formulario de Marca" />
                    <ProgressIndicator fx:id="piProgreso" prefHeight="20.0" prefWidth="20.0" styleClass="progress-small" visible="false" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblMensajeForm" styleClass="form-error-label" />
                </HBox>

                <!-- Grid del formulario -->
                <GridPane hgap="16" styleClass="form-grid" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" minWidth="80" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="150" />
                        <ColumnConstraints halignment="RIGHT" minWidth="80" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="200" />
                        <ColumnConstraints halignment="RIGHT" minWidth="80" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="250" />
                    </columnConstraints>

                    <!-- Fila 1: ID, Nombre, Descripción -->
                    <Label styleClass="form-label" text="ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <HBox alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label fx:id="lblId" styleClass="id-badge" text="—" />
                    </HBox>

                    <Label styleClass="form-label" text="Nombre:*" GridPane.columnIndex="2" GridPane.rowIndex="0" GridPane.valignment="TOP" />
                    <VBox spacing="2" GridPane.columnIndex="3" GridPane.rowIndex="0">
                        <TextField fx:id="txtNombre" promptText="Ingrese el nombre" styleClass="form-input" />
                        <HBox alignment="CENTER_RIGHT">
                            <Label fx:id="lblContadorNombre" styleClass="counter-normal" text="0/80" />
                        </HBox>
                    </VBox>

                    <Label styleClass="form-label" text="Descripción:" GridPane.columnIndex="4" GridPane.rowIndex="0" GridPane.valignment="TOP" />
                    <VBox spacing="2" GridPane.columnIndex="5" GridPane.rowIndex="0">
                        <TextArea fx:id="txtDescripcion" minHeight="80.0" prefHeight="96.0" prefWidth="450.0" promptText="Descripción opcional" styleClass="form-input" wrapText="true" />
                        <HBox alignment="CENTER_RIGHT">
                            <Label fx:id="lblContadorDesc" styleClass="counter-normal" text="0/600" />
                        </HBox>
                    </VBox>

                    <!-- Fila 2: Estado y Botones -->
                    <CheckBox fx:id="chkEstado" styleClass="form-checkbox" text="Activo" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                    <HBox alignment="CENTER_RIGHT" spacing="10" GridPane.columnIndex="5" GridPane.rowIndex="1">
                        <Button fx:id="btnGuardar" styleClass="btn-primary-small" text="Guardar">
                            <graphic>
                                <FontAwesomeIconView fill="WHITE" glyphName="CHECK" glyphSize="11" />
                            </graphic>
                        </Button>
                        <Button fx:id="btnCancelar" styleClass="btn-secondary-small" text="Cancelar">
                            <graphic>
                                <FontAwesomeIconView glyphName="TIMES" glyphSize="11" />
                            </graphic>
                        </Button>
                    </HBox>
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>
                </GridPane>
            </VBox>

            <!-- Tabla de Marcas -->
            <VBox spacing="10" styleClass="table-card" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label styleClass="table-title" text="Lista de Marcas" />
                    <Label fx:id="lblTotalMarcas" styleClass="table-count" text="(0 registros)" />
                </HBox>

                <TableView fx:id="tableMarcas" editable="false" styleClass="modern-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="60.0" styleClass="col-id" text="ID" />
                        <TableColumn fx:id="colNombre" prefWidth="200.0" styleClass="col-nombre" text="Nombre" />
                        <TableColumn fx:id="colDescripcion" prefWidth="350.0" styleClass="col-descripcion" text="Descripción" />
                        <TableColumn fx:id="colEstado" prefWidth="100.0" styleClass="col-estado" text="Estado" />
                    </columns>

                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>

                    <placeholder>
                        <VBox alignment="CENTER" spacing="8" style="-fx-padding: 40;">
                            <FontAwesomeIconView fill="#CBD5E1" glyphName="INBOX" glyphSize="48" />
                            <Label styleClass="table-empty-label" text="No hay marcas para mostrar" />
                            <Label styleClass="table-empty-hint" text="Agrega una nueva marca para comenzar" />
                        </VBox>
                    </placeholder>
                </TableView>

                <!-- Paginación mejorada -->
                <HBox alignment="CENTER" spacing="10" styleClass="pagination-bar">
                    <Button fx:id="btnPrimera" styleClass="btn-pagination">
                        <graphic>
                            <FontAwesomeIconView glyphName="ANGLE_DOUBLE_LEFT" glyphSize="12" />
                        </graphic>
                        <tooltip>
                            <Tooltip text="Primera página" />
                        </tooltip>
                    </Button>

                    <Button fx:id="btnAnterior" styleClass="btn-pagination">
                        <graphic>
                            <FontAwesomeIconView glyphName="CHEVRON_LEFT" glyphSize="12" />
                        </graphic>
                        <tooltip>
                            <Tooltip text="Página anterior" />
                        </tooltip>
                    </Button>

                    <Label styleClass="pagination-text" text="Página" />
                    <TextField fx:id="txtPagina" styleClass="pagination-input" text="1" />
                    <Label fx:id="lblTotalPaginas" styleClass="pagination-total" text="de 1" />

                    <Button fx:id="btnSiguiente" styleClass="btn-pagination">
                        <graphic>
                            <FontAwesomeIconView glyphName="CHEVRON_RIGHT" glyphSize="12" />
                        </graphic>
                        <tooltip>
                            <Tooltip text="Página siguiente" />
                        </tooltip>
                    </Button>

                    <Button fx:id="btnUltima" styleClass="btn-pagination">
                        <graphic>
                            <FontAwesomeIconView glyphName="ANGLE_DOUBLE_RIGHT" glyphSize="12" />
                        </graphic>
                        <tooltip>
                            <Tooltip text="Última página" />
                        </tooltip>
                    </Button>
                </HBox>
            </VBox>
            </VBox>
        </ScrollPane>
    </center>

    <padding>
        <Insets bottom="16" left="20" right="20" top="16" />
    </padding>
</BorderPane>
